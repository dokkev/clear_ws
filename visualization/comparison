#!/usr/bin/env python3
"""Visualization of tendon-driven underactuated adaptive grasping.

The comparison figure for a conventional tendon finger: one tendon command is
redistributed by torsional springs, while object contact is modeled as a
no-penetration constraint on the serial finger geometry.
"""

from __future__ import annotations

from dataclasses import dataclass
from pathlib import Path
import csv
import math
import sys

import matplotlib.font_manager as font_manager
import matplotlib.pyplot as plt
from matplotlib.lines import Line2D
from matplotlib.patches import Circle
import numpy as np


ROOT_DIR = Path(__file__).resolve().parents[1]
if str(ROOT_DIR) not in sys.path:
    sys.path.append(str(ROOT_DIR))

from finger.contact import ActiveContacts, CircleObject, sample_segment
from finger.tendon_finger import TendonFinger, TendonFingerConfig, TendonFingerState


OUT_DIR = ROOT_DIR / "output"
OUT_PNG = OUT_DIR / "tendon_finger_adaptive_grasp.png"
OUT_PDF = OUT_DIR / "tendon_finger_adaptive_grasp.pdf"
OUT_CSV = OUT_DIR / "tendon_finger_adaptive_grasp_metrics.csv"

LINK_COLORS = ("#c83232", "#2878a8", "#2d8f3a")
TRAJECTORY_COLOR = "#e67e22"
SPRING_COLOR = "#4b3a57"
CONTACT_COLOR = "#c62828"
OBJECT_FACE = "#d9d9d9"
OBJECT_EDGE = "#555555"
JOINT_LABELS = (r"$J_0$", r"$J_1$", r"$J_2$", r"$EE$")
OBJECT_RADIUS = 7.0
LINK_RADIUS = 2.2
PANEL_XLIM = (-45.0, 105.0)
PANEL_YLIM = (-75.0, 8.0)
PALM_START = np.array([0.0, 0.0], dtype=float)
PALM_END = np.array([-32.0, -10.0], dtype=float)


@dataclass(frozen=True)
class ObjectCase:
    name: str
    panel_label: str
    object_center: tuple[float, float]
    radius: float = OBJECT_RADIUS
    final_command: float = 1.25


CASES = (
    ObjectCase(
        name="proximal-middle object",
        panel_label="(a)",
        object_center=(34.730608, -10.795296),
        final_command=0.95,
    ),
    ObjectCase(
        name="middle-distal object",
        panel_label="(b)",
        object_center=(37.686544, -43.484382),
        final_command=1.10,
    ),
    ObjectCase(
        name="palm-proximal object",
        panel_label="(c)",
        object_center=(-2.904075, -8.241360),
        final_command=0.40,
    ),
)


def configure_figure_style() -> None:
    serif_candidates = [
        "Times New Roman",
        "Times",
        "Nimbus Roman",
        "Nimbus Roman No9 L",
        "Liberation Serif",
        "DejaVu Serif",
    ]
    available_fonts = {font.name for font in font_manager.fontManager.ttflist}
    serif_font = next((font for font in serif_candidates if font in available_fonts), "DejaVu Serif")
    plt.rcParams.update({
        "font.family": "serif",
        "font.serif": [serif_font, *[font for font in serif_candidates if font != serif_font]],
        "font.size": 9,
        "mathtext.fontset": "stix",
        "axes.titlesize": 10.5,
        "axes.linewidth": 0.75,
        "legend.fontsize": 8.2,
        "savefig.dpi": 300,
    })


def unit(v: np.ndarray) -> np.ndarray:
    norm = float(np.linalg.norm(v))
    if norm < 1e-12:
        return np.array([1.0, 0.0])
    return v / norm


def palm_contact_normal() -> np.ndarray:
    """Palm-side normal for placing the object under the slanted palm."""
    tangent = unit(PALM_END - PALM_START)
    return np.array([-tangent[1], tangent[0]])


def palm_segment() -> np.ndarray:
    return np.vstack((PALM_START, PALM_END))


def object_for_case(finger: TendonFinger, case: ObjectCase) -> CircleObject:
    return CircleObject(center=case.object_center, radius=case.radius)


def draw_object(ax, object_geom: CircleObject) -> tuple[np.ndarray, float]:
    patch = Circle(
        object_geom.center,
        object_geom.radius,
        facecolor=OBJECT_FACE,
        edgecolor=OBJECT_EDGE,
        linewidth=0.9,
        alpha=0.92,
        zorder=1,
    )
    ax.add_patch(patch)
    ax.scatter(
        [object_geom.center[0]],
        [object_geom.center[1]],
        s=13,
        facecolor="white",
        edgecolor=OBJECT_EDGE,
        linewidth=0.65,
        zorder=3,
    )
    return object_geom.center, object_geom.radius


def draw_torsion_spring(ax, center: np.ndarray, radius: float = 2.25) -> None:
    t = np.linspace(0.0, 4.4 * math.pi, 90)
    r = np.linspace(0.35 * radius, radius, len(t))
    points = center[None, :] + np.column_stack((r * np.cos(t), r * np.sin(t)))
    ax.plot(points[:, 0], points[:, 1], color=SPRING_COLOR, linewidth=0.55, alpha=0.82, zorder=6)


def draw_end_effector_trajectory(ax, free_tips: np.ndarray, contact_tips: np.ndarray) -> None:
    """Draw unloaded and contact-dependent fingertip paths as trajectory data."""
    ax.plot(
        free_tips[:, 0],
        free_tips[:, 1],
        color="#b0b0b0",
        linestyle="--",
        linewidth=1.05,
        alpha=0.70,
        zorder=2,
    )
    ax.plot(
        contact_tips[:, 0],
        contact_tips[:, 1],
        color=TRAJECTORY_COLOR,
        linewidth=2.7,
        alpha=0.96,
        solid_capstyle="round",
        zorder=8,
    )
    ax.scatter(
        [contact_tips[0, 0]],
        [contact_tips[0, 1]],
        s=22,
        facecolor="white",
        edgecolor=TRAJECTORY_COLOR,
        linewidth=1.0,
        zorder=9,
    )
    ax.scatter(
        [contact_tips[-1, 0]],
        [contact_tips[-1, 1]],
        s=34,
        facecolor=TRAJECTORY_COLOR,
        edgecolor="white",
        linewidth=0.75,
        zorder=9,
    )


def draw_finger(ax, state: TendonFingerState, alpha: float = 1.0, linewidth: float = 2.35) -> None:
    joints = state.joint_positions
    for idx, color in enumerate(LINK_COLORS):
        segment = joints[idx: idx + 2]
        ax.plot(
            segment[:, 0],
            segment[:, 1],
            color="#202020",
            linewidth=linewidth + 1.3,
            alpha=0.70 * alpha,
            solid_capstyle="butt",
            zorder=4,
        )
        ax.plot(
            segment[:, 0],
            segment[:, 1],
            color=color,
            linewidth=linewidth,
            alpha=0.92 * alpha,
            solid_capstyle="butt",
            zorder=5,
        )

    for joint in joints[:3]:
        draw_torsion_spring(ax, joint)
    ax.scatter(
        joints[:, 0],
        joints[:, 1],
        s=[26, 22, 22, 25],
        facecolor="white",
        edgecolor="#151515",
        linewidth=0.85,
        zorder=7,
    )
    for label, joint in zip(JOINT_LABELS, joints):
        ax.text(
            joint[0] + 1.0,
            joint[1] + 1.0,
            label,
            fontsize=6.9,
            color="#202020",
            zorder=11,
        )


def draw_initial_finger(ax, finger: TendonFinger) -> None:
    """Draw the fully extended initial pose transparently."""
    joints = finger.forward_kinematics([0.0, 0.0, 0.0])
    for idx, color in enumerate(LINK_COLORS):
        segment = joints[idx: idx + 2]
        ax.plot(
            segment[:, 0],
            segment[:, 1],
            color=color,
            linewidth=2.8,
            alpha=0.17,
            linestyle="-",
            solid_capstyle="butt",
            zorder=0,
        )
    ax.scatter(
        joints[:, 0],
        joints[:, 1],
        s=[22, 18, 18, 20],
        facecolor="white",
        edgecolor="#808080",
        linewidth=0.65,
        alpha=0.36,
        zorder=0.2,
    )


def draw_palm(ax) -> None:
    palm = palm_segment()
    tangent = unit(PALM_END - PALM_START)
    normal = palm_contact_normal()
    ax.plot(
        palm[:, 0],
        palm[:, 1],
        color="#5f5f5f",
        linewidth=2.0,
        solid_capstyle="butt",
        zorder=3.5,
    )
    ax.plot(
        palm[:, 0],
        palm[:, 1],
        color="#bdbdbd",
        linewidth=4.6,
        alpha=0.35,
        solid_capstyle="butt",
        zorder=3.4,
    )
    for fraction in np.linspace(0.12, 0.88, 6):
        point = PALM_START + fraction * (PALM_END - PALM_START)
        hatch_start = point + 2.4 * normal - 0.9 * tangent
        hatch_end = point + 0.35 * normal + 0.9 * tangent
        ax.plot(
            [hatch_start[0], hatch_end[0]],
            [hatch_start[1], hatch_end[1]],
            color="#777777",
            linewidth=0.65,
            alpha=0.78,
            zorder=3.3,
        )
    label_position = 0.55 * PALM_END + 3.5 * normal
    ax.text(
        label_position[0],
        label_position[1],
        "palm",
        fontsize=7.2,
        color="#555555",
        zorder=12,
    )


def state_active_contacts(state: TendonFingerState) -> ActiveContacts:
    """Convert solver contact samples into the generic active-contact container."""
    if state.contact_points is None or state.contact_normals is None or len(state.contact_link_ids) == 0:
        return ActiveContacts.empty()

    points = np.asarray(state.contact_points, dtype=float).reshape(-1, 2)
    normals = np.asarray(state.contact_normals, dtype=float).reshape(-1, 2)
    owner_ids = np.asarray(state.contact_link_ids, dtype=int)
    owner_names = (
        state.contact_owner_names
        if len(state.contact_owner_names) == len(owner_ids)
        else tuple(f"link_{idx}" for idx in owner_ids)
    )
    margins = (
        np.asarray(state.contact_margins, dtype=float).reshape(-1)
        if state.contact_margins is not None
        else np.zeros(len(points), dtype=float)
    )
    return ActiveContacts(
        points=points,
        normals=normals,
        owner_ids=owner_ids,
        owner_names=owner_names,
        margins=margins,
        source_points=points,
        source_radii=np.full(len(points), LINK_RADIUS, dtype=float),
    )


def palm_active_contacts(object_geom: CircleObject) -> ActiveContacts:
    """Detect static palm contacts with the same generic sample framework."""
    palm_samples = sample_segment(
        PALM_START,
        PALM_END,
        radius=0.0,
        owner_id=-1,
        owner_name="palm",
        samples=31,
        endpoint_margin=0.02,
    )
    return palm_samples.active_contacts(object_geom, margin_tol=0.35).representatives_by_owner()


def select_visual_contacts(
    finger_contacts: ActiveContacts,
    palm_contacts: ActiveContacts,
    max_points: int = 3,
) -> ActiveContacts:
    """Prefer distinct owners, then fill a 3-contact patch by closest samples."""
    selected = finger_contacts.representatives_by_owner().append(palm_contacts.representatives_by_owner())
    if len(selected.points) >= max_points or len(finger_contacts.points) == 0:
        if len(selected.points) <= max_points:
            return selected
        keep = np.argsort(selected.margins)[:max_points]
        return ActiveContacts(
            points=selected.points[keep],
            normals=selected.normals[keep],
            owner_ids=selected.owner_ids[keep],
            owner_names=tuple(np.asarray(selected.owner_names, dtype=object)[keep]),
            margins=selected.margins[keep],
            source_points=selected.source_points[keep],
            source_radii=selected.source_radii[keep],
        )

    existing = set(zip(selected.owner_ids.tolist(), selected.owner_names))
    extra_indices = []
    for idx in np.argsort(finger_contacts.margins):
        key = (int(finger_contacts.owner_ids[idx]), finger_contacts.owner_names[idx])
        duplicate_point = (
            len(selected.points) > 0
            and np.min(np.linalg.norm(selected.points - finger_contacts.points[idx][None, :], axis=1)) < 1e-6
        )
        if duplicate_point:
            continue
        if key in existing and len(selected.points) + len(extra_indices) < max_points:
            extra_indices.append(int(idx))
        if len(selected.points) + len(extra_indices) >= max_points:
            break
    if not extra_indices:
        return selected
    extra = ActiveContacts(
        points=finger_contacts.points[extra_indices],
        normals=finger_contacts.normals[extra_indices],
        owner_ids=finger_contacts.owner_ids[extra_indices],
        owner_names=tuple(np.asarray(finger_contacts.owner_names, dtype=object)[extra_indices]),
        margins=finger_contacts.margins[extra_indices],
        source_points=finger_contacts.source_points[extra_indices],
        source_radii=finger_contacts.source_radii[extra_indices],
    )
    return selected.append(extra)


def draw_contacts(ax, contacts: np.ndarray, normals: np.ndarray) -> None:
    """Draw object reaction forces acting on the contacted finger links."""
    if len(contacts) == 0:
        return
    ax.scatter(
        contacts[:, 0],
        contacts[:, 1],
        s=25,
        facecolor=CONTACT_COLOR,
        edgecolor="white",
        linewidth=0.75,
        zorder=9,
    )
    for idx, (contact, normal) in enumerate(zip(contacts, normals)):
        reaction = unit(normal)
        start = contact - 0.70 * reaction
        end = contact + 4.0 * reaction
        ax.annotate(
            "",
            xy=end,
            xytext=start,
            arrowprops={
                "arrowstyle": "-|>",
                "color": CONTACT_COLOR,
                "lw": 1.15,
                "mutation_scale": 8.5,
                "shrinkA": 0,
                "shrinkB": 0,
            },
            zorder=9,
        )


def apply_panel_axes(ax, point_sets: list[np.ndarray], circles: list[tuple[np.ndarray, float]]) -> None:
    """Set padded limits and a light Matplotlib-style grid."""
    ax.set_aspect("equal", adjustable="box")
    ax.set_xlim(*PANEL_XLIM)
    ax.set_ylim(*PANEL_YLIM)
    ax.set_axisbelow(True)
    ax.grid(True, color="#d9d9d9", linewidth=0.55, alpha=0.85)
    ax.tick_params(axis="both", labelsize=7, direction="in", width=0.55, length=2.8)
    ax.set_xlabel(r"$x$", fontsize=8)
    ax.set_ylabel(r"$y$", fontsize=8)
    for spine in ax.spines.values():
        spine.set_color("#777777")
        spine.set_linewidth(0.65)


def draw_case_panel(ax, finger: TendonFinger, case: ObjectCase) -> dict[str, float | str]:
    commands = np.linspace(0.0, case.final_command, 86)
    free_traj = finger.solve_many(commands)
    object_geom = object_for_case(finger, case)
    contact_traj = finger.solve_many_with_object(
        commands,
        object_geom,
        link_radius=LINK_RADIUS,
        samples_per_link=19,
        active_margin_tol=1.05,
    )
    final_state = contact_traj.states[-1]

    draw_initial_finger(ax, finger)
    draw_end_effector_trajectory(ax, free_traj.tips, contact_traj.tips)
    draw_palm(ax)

    object_center, object_radius = draw_object(ax, object_geom)
    draw_finger(ax, final_state)
    finger_contacts = state_active_contacts(final_state)
    palm_contacts = palm_active_contacts(object_geom)
    visual_contacts = select_visual_contacts(finger_contacts, palm_contacts, max_points=3)
    draw_contacts(ax, visual_contacts.points, visual_contacts.normals)

    q_deg = np.rad2deg(final_state.q)
    ax.text(
        0.02,
        0.98,
        f"{case.panel_label} {case.name}",
        transform=ax.transAxes,
        ha="left",
        va="top",
        fontweight="bold",
        fontsize=9.5,
        zorder=20,
    )

    apply_panel_axes(
        ax,
        [
            finger.forward_kinematics([0.0, 0.0, 0.0]),
            final_state.joint_positions,
            free_traj.tips,
            contact_traj.tips,
            visual_contacts.points,
            palm_segment(),
        ],
        [(object_center, object_radius)],
    )

    return {
        "case": case.name,
        "object_kind": "circle",
        "object_radius": object_radius,
        "object_center_x": object_center[0],
        "object_center_y": object_center[1],
        "visual_contact_point_count": len(visual_contacts.points),
        "active_contact_owners": " ".join(visual_contacts.owner_names),
        "solver_contact_owners": " ".join(finger_contacts.representatives_by_owner().owner_names),
        "final_command": final_state.command,
        "q_mcp_deg": q_deg[0],
        "q_pip_deg": q_deg[1],
        "q_dip_deg": q_deg[2],
        "spring_energy": final_state.spring_energy,
        "tendon_potential": final_state.tendon_potential,
        "max_penetration": final_state.max_penetration,
        "min_contact_margin": final_state.min_contact_margin,
        "optimization_success": str(final_state.optimization_success),
        "optimization_message": final_state.optimization_message,
        "tip_x": final_state.tip[0],
        "tip_y": final_state.tip[1],
    }


def write_metrics(rows: list[dict[str, float | str]], path: Path) -> None:
    fieldnames = list(rows[0].keys())
    with path.open("w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(rows)


def make_figure() -> None:
    configure_figure_style()
    OUT_DIR.mkdir(parents=True, exist_ok=True)

    finger = TendonFinger(
        TendonFingerConfig(
            link_lengths=(40.0, 28.0, 22.0),
            spring_stiffness=(1.25, 0.85, 0.55),
            tendon_moment_arms=(1.00, 0.86, 0.68),
        )
    )

    fig, axes = plt.subplots(1, 3, figsize=(10.2, 3.65), constrained_layout=True)
    rows = [draw_case_panel(ax, finger, case) for ax, case in zip(axes, CASES)]

    handles = [
        Line2D([0], [0], color=TRAJECTORY_COLOR, linewidth=2.4, label="Contact-dependent EE trajectory"),
        Line2D([0], [0], color="#b0b0b0", linestyle="--", linewidth=1.2, label="Nominal fingertip trajectory"),
    ]
    fig.legend(handles=handles, loc="lower center", ncol=2, frameon=False, bbox_to_anchor=(0.5, -0.035))
    fig.suptitle(
        "Parametric tendon-finger model under object contact",
        fontsize=11.2,
        y=1.02,
    )
    fig.savefig(OUT_PNG, dpi=300, bbox_inches="tight")
    fig.savefig(OUT_PDF, bbox_inches="tight")
    plt.close(fig)
    write_metrics(rows, OUT_CSV)

    print("Saved:", OUT_PNG)
    print("Saved:", OUT_PDF)
    print("Saved:", OUT_CSV)


if __name__ == "__main__":
    make_figure()
