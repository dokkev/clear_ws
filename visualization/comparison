#!/usr/bin/env python3
"""Visualization of tendon-driven underactuated adaptive grasping.

The deterministic linkage finger keeps a prescribed gross pose. This script is
the comparison figure for a conventional tendon finger: one tendon command is
redistributed by torsional springs, and object contact locks whichever joint is
blocked by the object.
"""

from __future__ import annotations

from dataclasses import dataclass
from pathlib import Path
import csv
import math
import sys

import matplotlib.font_manager as font_manager
import matplotlib.pyplot as plt
from matplotlib.lines import Line2D
from matplotlib.patches import Circle
import numpy as np


ROOT_DIR = Path(__file__).resolve().parents[1]
if str(ROOT_DIR) not in sys.path:
    sys.path.append(str(ROOT_DIR))

from finger.tendon_finger import TendonFinger, TendonFingerConfig, TendonFingerState


OUT_DIR = ROOT_DIR / "output"
OUT_PNG = OUT_DIR / "tendon_finger_adaptive_grasp.png"
OUT_PDF = OUT_DIR / "tendon_finger_adaptive_grasp.pdf"
OUT_CSV = OUT_DIR / "tendon_finger_adaptive_grasp_metrics.csv"

LINK_COLORS = ("#c83232", "#2878a8", "#2d8f3a")
TRAJECTORY_COLOR = "#e67e22"
SPRING_COLOR = "#4b3a57"
CONTACT_COLOR = "#c62828"
OBJECT_FACE = "#d9d9d9"
OBJECT_EDGE = "#555555"
JOINT_LABELS = (r"$J_0$", r"$J_1$", r"$J_2$", r"$EE$")


@dataclass(frozen=True)
class ObjectCase:
    name: str
    panel_label: str
    contact_commands: dict[str, float]
    contact_specs: tuple[tuple[str, float], ...]
    radius: float = 8.0
    final_command: float = 1.25


CASES = (
    ObjectCase(
        name="proximal-middle object",
        panel_label="(a)",
        contact_commands={"mcp": 0.36, "pip": 0.62},
        contact_specs=(("mcp", 0.92), ("pip", 0.06)),
        radius=7.5,
    ),
    ObjectCase(
        name="middle-distal object",
        panel_label="(b)",
        contact_commands={"pip": 0.48, "dip": 0.82},
        contact_specs=(("pip", 0.84), ("dip", 0.10)),
        radius=6.0,
    ),
    ObjectCase(
        name="distal-side object",
        panel_label="(c)",
        contact_commands={"pip": 0.70, "dip": 0.96},
        contact_specs=(("pip", 0.86), ("dip", 0.24)),
        radius=6.8,
    ),
)


def configure_figure_style() -> None:
    serif_candidates = [
        "Times New Roman",
        "Times",
        "Nimbus Roman",
        "Nimbus Roman No9 L",
        "Liberation Serif",
        "DejaVu Serif",
    ]
    available_fonts = {font.name for font in font_manager.fontManager.ttflist}
    serif_font = next((font for font in serif_candidates if font in available_fonts), "DejaVu Serif")
    plt.rcParams.update({
        "font.family": "serif",
        "font.serif": [serif_font, *[font for font in serif_candidates if font != serif_font]],
        "font.size": 9,
        "mathtext.fontset": "stix",
        "axes.titlesize": 10.5,
        "axes.linewidth": 0.75,
        "legend.fontsize": 8.2,
        "savefig.dpi": 300,
    })


def unit(v: np.ndarray) -> np.ndarray:
    norm = float(np.linalg.norm(v))
    if norm < 1e-12:
        return np.array([1.0, 0.0])
    return v / norm


def palmar_normal(start: np.ndarray, end: np.ndarray) -> np.ndarray:
    """Normal pointing toward the grasp interior for the chosen flexion sign."""
    tangent = unit(end - start)
    return np.array([tangent[1], -tangent[0]])


def joint_index(joint_name: str) -> int:
    return {"mcp": 0, "pip": 1, "dip": 2}[joint_name]


def contact_points_and_normals(state: TendonFingerState, case: ObjectCase) -> tuple[np.ndarray, np.ndarray]:
    contacts = []
    normals = []
    for joint_name, fraction in case.contact_specs:
        idx = joint_index(joint_name)
        start = state.joint_positions[idx]
        end = state.joint_positions[idx + 1]
        contacts.append(start + fraction * (end - start))
        normals.append(palmar_normal(start, end))
    return np.asarray(contacts, dtype=float), np.asarray(normals, dtype=float)


def circle_center_from_contacts(
    contacts: np.ndarray,
    normals: np.ndarray,
    requested_radius: float,
) -> tuple[np.ndarray, float]:
    """Choose a circle tangent to the local palmar contact normals."""
    if len(contacts) < 2:
        radius = requested_radius
        return contacts[0] + normals[0] * radius, radius

    rows = []
    rhs = []
    for contact, normal in zip(contacts, normals):
        rows.append([1.0, 0.0, -normal[0]])
        rhs.append(contact[0])
        rows.append([0.0, 1.0, -normal[1]])
        rhs.append(contact[1])

    solution, *_unused = np.linalg.lstsq(np.asarray(rows), np.asarray(rhs), rcond=None)
    center = solution[:2]
    radius = float(solution[2])
    if not np.isfinite(radius) or radius <= 1.0:
        radius = float(requested_radius)
        center = np.mean(contacts + radius * normals, axis=0)
    return center, radius


def draw_object(ax, state: TendonFingerState, case: ObjectCase) -> tuple[np.ndarray, np.ndarray, np.ndarray, float]:
    contacts, normals = contact_points_and_normals(state, case)
    center, radius = circle_center_from_contacts(contacts, normals, case.radius)
    patch = Circle(
        center,
        radius,
        facecolor=OBJECT_FACE,
        edgecolor=OBJECT_EDGE,
        linewidth=0.9,
        alpha=0.92,
        zorder=1,
    )
    ax.add_patch(patch)
    ax.scatter(
        [center[0]],
        [center[1]],
        s=13,
        facecolor="white",
        edgecolor=OBJECT_EDGE,
        linewidth=0.65,
        zorder=3,
    )
    ax.plot(
        [center[0], contacts[0, 0]],
        [center[1], contacts[0, 1]],
        color=OBJECT_EDGE,
        linewidth=0.65,
        alpha=0.55,
        linestyle=":",
        zorder=3,
    )
    return contacts, normals, center, radius


def draw_torsion_spring(ax, center: np.ndarray, radius: float = 2.25) -> None:
    t = np.linspace(0.0, 4.4 * math.pi, 90)
    r = np.linspace(0.35 * radius, radius, len(t))
    points = center[None, :] + np.column_stack((r * np.cos(t), r * np.sin(t)))
    ax.plot(points[:, 0], points[:, 1], color=SPRING_COLOR, linewidth=0.55, alpha=0.82, zorder=6)


def draw_end_effector_trajectory(ax, free_tips: np.ndarray, contact_tips: np.ndarray) -> None:
    """Draw unloaded and contact-dependent fingertip paths as trajectory data."""
    ax.plot(
        free_tips[:, 0],
        free_tips[:, 1],
        color="#b0b0b0",
        linestyle="--",
        linewidth=1.05,
        alpha=0.70,
        zorder=2,
    )
    ax.plot(
        contact_tips[:, 0],
        contact_tips[:, 1],
        color=TRAJECTORY_COLOR,
        linewidth=2.7,
        alpha=0.96,
        solid_capstyle="round",
        zorder=8,
    )
    ax.scatter(
        [contact_tips[0, 0]],
        [contact_tips[0, 1]],
        s=22,
        facecolor="white",
        edgecolor=TRAJECTORY_COLOR,
        linewidth=1.0,
        zorder=9,
    )
    ax.scatter(
        [contact_tips[-1, 0]],
        [contact_tips[-1, 1]],
        s=34,
        facecolor=TRAJECTORY_COLOR,
        edgecolor="white",
        linewidth=0.75,
        zorder=9,
    )


def draw_finger(ax, state: TendonFingerState, alpha: float = 1.0, linewidth: float = 2.35) -> None:
    joints = state.joint_positions
    for idx, color in enumerate(LINK_COLORS):
        segment = joints[idx: idx + 2]
        ax.plot(
            segment[:, 0],
            segment[:, 1],
            color="#202020",
            linewidth=linewidth + 1.3,
            alpha=0.70 * alpha,
            solid_capstyle="butt",
            zorder=4,
        )
        ax.plot(
            segment[:, 0],
            segment[:, 1],
            color=color,
            linewidth=linewidth,
            alpha=0.92 * alpha,
            solid_capstyle="butt",
            zorder=5,
        )

    for joint in joints[:3]:
        draw_torsion_spring(ax, joint)
    ax.scatter(
        joints[:, 0],
        joints[:, 1],
        s=[26, 22, 22, 25],
        facecolor="white",
        edgecolor="#151515",
        linewidth=0.85,
        zorder=7,
    )
    for label, joint in zip(JOINT_LABELS, joints):
        ax.text(
            joint[0] + 1.0,
            joint[1] + 1.0,
            label,
            fontsize=6.9,
            color="#202020",
            zorder=11,
        )


def draw_initial_finger(ax, finger: TendonFinger) -> None:
    """Draw the fully extended initial pose transparently."""
    joints = finger.forward_kinematics([0.0, 0.0, 0.0])
    for idx, color in enumerate(LINK_COLORS):
        segment = joints[idx: idx + 2]
        ax.plot(
            segment[:, 0],
            segment[:, 1],
            color=color,
            linewidth=2.8,
            alpha=0.17,
            linestyle="-",
            solid_capstyle="butt",
            zorder=0,
        )
    ax.scatter(
        joints[:, 0],
        joints[:, 1],
        s=[22, 18, 18, 20],
        facecolor="white",
        edgecolor="#808080",
        linewidth=0.65,
        alpha=0.36,
        zorder=0.2,
    )


def draw_contacts(ax, contacts: np.ndarray, normals: np.ndarray) -> None:
    ax.scatter(
        contacts[:, 0],
        contacts[:, 1],
        s=31,
        facecolor=CONTACT_COLOR,
        edgecolor="white",
        linewidth=0.75,
        zorder=9,
    )
    for contact, normal in zip(contacts, normals):
        start = contact + 0.45 * normal
        end = contact - 2.7 * normal
        ax.annotate(
            "",
            xy=end,
            xytext=start,
            arrowprops={
                "arrowstyle": "-|>",
                "color": CONTACT_COLOR,
                "lw": 0.8,
                "shrinkA": 0,
                "shrinkB": 0,
            },
            zorder=9,
        )


def apply_panel_axes(ax, point_sets: list[np.ndarray], circles: list[tuple[np.ndarray, float]]) -> None:
    """Set padded limits and a light Matplotlib-style grid."""
    points = [np.asarray(points, dtype=float).reshape(-1, 2) for points in point_sets if len(points)]
    for center, radius in circles:
        center = np.asarray(center, dtype=float)
        points.append(np.vstack((center - radius, center + radius)))

    all_points = np.vstack(points)
    xy_min = np.min(all_points, axis=0)
    xy_max = np.max(all_points, axis=0)
    span = np.maximum(xy_max - xy_min, np.array([1.0, 1.0]))
    margin = np.maximum(0.11 * span, np.array([6.0, 6.0]))

    ax.set_aspect("equal", adjustable="box")
    ax.set_xlim(float(xy_min[0] - margin[0]), float(xy_max[0] + margin[0]))
    ax.set_ylim(float(xy_min[1] - margin[1]), float(xy_max[1] + margin[1]))
    ax.set_axisbelow(True)
    ax.grid(True, color="#d9d9d9", linewidth=0.55, alpha=0.85)
    ax.tick_params(axis="both", labelsize=7, direction="in", width=0.55, length=2.8)
    ax.set_xlabel(r"$x$", fontsize=8)
    ax.set_ylabel(r"$y$", fontsize=8)
    for spine in ax.spines.values():
        spine.set_color("#777777")
        spine.set_linewidth(0.65)


def draw_case_panel(ax, finger: TendonFinger, case: ObjectCase) -> dict[str, float | str]:
    commands = np.linspace(0.0, case.final_command, 150)
    free_traj = finger.solve_many(commands)
    contact_traj = finger.simulate_contact_sequence(commands, case.contact_commands)
    final_state = contact_traj.states[-1]

    draw_initial_finger(ax, finger)
    draw_end_effector_trajectory(ax, free_traj.tips, contact_traj.tips)

    contacts, normals, object_center, object_radius = draw_object(ax, final_state, case)
    draw_finger(ax, final_state)
    draw_contacts(ax, contacts, normals)

    q_deg = np.rad2deg(final_state.q)
    active = ", ".join(name.upper() for name in final_state.active_contact_joints) or "none"
    ax.text(
        0.02,
        0.98,
        f"{case.panel_label} {case.name}",
        transform=ax.transAxes,
        ha="left",
        va="top",
        fontweight="bold",
        fontsize=9.5,
        zorder=20,
    )
    ax.text(
        0.02,
        0.07,
        f"locked: {active}\n"
        f"q = [{q_deg[0]:.0f}, {q_deg[1]:.0f}, {q_deg[2]:.0f}] deg",
        transform=ax.transAxes,
        ha="left",
        va="bottom",
        fontsize=8.4,
        bbox={"boxstyle": "round,pad=0.25", "facecolor": "white", "edgecolor": "#d0d0d0", "alpha": 0.88},
        zorder=20,
    )

    apply_panel_axes(
        ax,
        [
            finger.forward_kinematics([0.0, 0.0, 0.0]),
            final_state.joint_positions,
            free_traj.tips,
            contact_traj.tips,
            contacts,
        ],
        [(object_center, object_radius)],
    )

    return {
        "case": case.name,
        "object_kind": "circle",
        "object_radius": object_radius,
        "contact_joints": " ".join(joint_name for joint_name, _fraction in case.contact_specs),
        "contact_point_count": len(case.contact_specs),
        "locked_joints": " ".join(final_state.active_contact_joints),
        "final_command": final_state.command,
        "q_mcp_deg": q_deg[0],
        "q_pip_deg": q_deg[1],
        "q_dip_deg": q_deg[2],
        "spring_energy": final_state.spring_energy,
        "tendon_potential": final_state.tendon_potential,
        "contact_reaction_mcp": final_state.contact_reaction_torque[0],
        "contact_reaction_pip": final_state.contact_reaction_torque[1],
        "contact_reaction_dip": final_state.contact_reaction_torque[2],
        "max_abs_equilibrium_residual_torque": final_state.max_abs_equilibrium_residual_torque,
        "tip_x": final_state.tip[0],
        "tip_y": final_state.tip[1],
    }


def write_metrics(rows: list[dict[str, float | str]], path: Path) -> None:
    fieldnames = list(rows[0].keys())
    with path.open("w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(rows)


def make_figure() -> None:
    configure_figure_style()
    OUT_DIR.mkdir(parents=True, exist_ok=True)

    finger = TendonFinger(
        TendonFingerConfig(
            link_lengths=(40.0, 28.0, 22.0),
            spring_stiffness=(1.25, 0.85, 0.55),
            tendon_moment_arms=(1.00, 0.86, 0.68),
        )
    )

    fig, axes = plt.subplots(1, 3, figsize=(10.2, 3.65), constrained_layout=True)
    rows = [draw_case_panel(ax, finger, case) for ax, case in zip(axes, CASES)]

    handles = [
        Line2D([0], [0], color=TRAJECTORY_COLOR, linewidth=2.4, label="Contact-dependent EE trajectory"),
        Line2D([0], [0], color="#b0b0b0", linestyle="--", linewidth=1.2, label="Nominal fingertip trajectory"),
    ]
    fig.legend(handles=handles, loc="lower center", ncol=2, frameon=False, bbox_to_anchor=(0.5, -0.035))
    fig.suptitle(
        "Parametric tendon-finger model under object contact",
        fontsize=11.2,
        y=1.02,
    )
    fig.savefig(OUT_PNG, dpi=300, bbox_inches="tight")
    fig.savefig(OUT_PDF, bbox_inches="tight")
    plt.close(fig)
    write_metrics(rows, OUT_CSV)

    print("Saved:", OUT_PNG)
    print("Saved:", OUT_PDF)
    print("Saved:", OUT_CSV)


if __name__ == "__main__":
    make_figure()
